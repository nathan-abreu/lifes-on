SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Após a revisão/autorização de seguranca_backend.sql, o Flask exige credencial
# exclusiva do servidor, configurada ANTES de executar o SQL.
# Escolha uma opção: chave atual (recomendada) ou JWT legado service_role.
SUPABASE_SECRET_KEY=sb_secret_SUBSTITUA_PELA_CHAVE_REAL
# SUPABASE_SERVICE_ROLE_KEY=JWT_SERVICE_ROLE_LEGADO
# Não use anon/sb_publishable_ no backend restrito. Não mantenha placeholders ativos.
LIFES_REQUIRE_SERVER_KEY=1
# Nunca enviar a chave aos templates, JavaScript, logs ou commits.
FLASK_SECRET_KEY=troque-por-uma-string-aleatoria-longa
# Criar manualmente um bucket PRIVADO com este nome antes de habilitar fotos.
SUPABASE_AVATAR_BUCKET=lifes-perfis
# Tipo real de atividades.data_registro. No projeto atual foi confirmado DATE.
# Banco novo via schema.sql: timestamptz. Legado sem offset: timestamp (UTC).
LIFES_DATA_REGISTRO_TIPO=date
